[Desktop Entry]
Type=Application
Version=1.0
Name=RuscaCleaner
GenericName=System cleaner
GenericName[it]=Pulizia del sistema
GenericName[es]=Limpieza del sistema
GenericName[fr]=Nettoyage du système
GenericName[de]=Systembereinigung
GenericName[pt]=Limpeza do sistema
GenericName[ru]=Очистка системы
Comment=Removes thumbnails, recent files and shell history
Comment[it]=Rimuove miniature, file recenti e cronologia della shell
Comment[es]=Elimina miniaturas, archivos recientes e historial del intérprete
Comment[fr]=Supprime les vignettes, les fichiers récents et l'historique du shell
Comment[de]=Entfernt Miniaturansichten, zuletzt benutzte Dateien und Shell-Verlauf
Comment[pt]=Remove miniaturas, ficheiros recentes e histórico da shell
Comment[ru]=Удаляет миниатюры, недавние файлы и историю командной оболочки
Exec=ruscacleaner
Icon=ruscacleaner
Terminal=false
Categories=GTK;GNOME;System;Filesystem;
Keywords=clean;cache;thumbnails;history;trash;privacy;space;
Keywords[it]=pulizia;cache;miniature;cronologia;cestino;privacy;spazio;
Keywords[es]=limpieza;caché;miniaturas;historial;papelera;privacidad;espacio;
Keywords[fr]=nettoyage;cache;vignettes;historique;corbeille;confidentialité;espace;
Keywords[de]=bereinigen;Zwischenspeicher;Miniaturansichten;Verlauf;Papierkorb;Datenschutz;Speicherplatz;
Keywords[pt]=limpeza;cache;miniaturas;histórico;lixo;privacidade;espaço;
Keywords[ru]=очистка;кэш;миниатюры;история;корзина;конфиденциальность;место;
StartupNotify=true
StartupWMClass=org.ruscalinux.RuscaCleaner
