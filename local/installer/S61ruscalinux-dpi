# RuscaLinux — dimensione del testo dell'installer grafico.
#
# Questo file viene letto (non eseguito) dall'installer all'avvio, prima di
# S62Xorg: niente "exit", niente "set -e", variabili con prefisso rl_.
#
# L'installer usa DejaVu Sans 9 pt (gtk-set-font) e Xorg parte a 96 DPI:
# su uno schermo Full HD il testo e' alto circa 15 pixel. Qui si fa partire
# Xorg con una risoluzione proporzionale all'altezza dello schermo, cosi'
# crescono tutti i caratteri insieme, compresi quelli che gtk-set-font
# ingrandisce per alcune lingue e per il tema ad alto contrasto.
#
# Regola: l'installer occupa lo schermo come su uno schermo alto 640 punti,
# su qualunque monitor (DPI = altezza x 96 / 640 = altezza x 3 / 20).
# Non meno di 640: l'installer di Debian e' pensato per 800x600 e alcune
# schermate (lingue, paesi, partizioni) non entrerebbero.
#
#   altezza  640 o meno  ->  96 DPI (come Debian)
#   altezza  768         -> 115 DPI
#   altezza 1080         -> 162 DPI (Full HD)
#   altezza 1440         -> 216 DPI
#   altezza 2160         -> 324 DPI (4K)
#   altezza 2560 o piu'  -> 384 DPI (massimo)
#
# Come arriva a Xorg: S62Xorg di Debian (rootskel-gtk), che gira subito
# dopo questo file, avvia il server con "Xorg $DPMS -noreset ...". Qui si
# aggiunge "-dpi N" in quella riga del file, prima che venga eseguito:
#     Xorg $DPMS ...   ->   Xorg -dpi N $DPMS ...
# L'initrd dell'installer e' in memoria, quindi il file si puo' modificare.
# Non si usa la variabile DPMS: in trixie S62Xorg la imposta da se' ("-s 0")
# e cancellerebbe il valore. Se Debian cambiasse quella riga, la modifica
# non si applica e il testo resta come prima; build.sh controlla sull'initrd
# della ISO che la riga ci sia ancora. Lo script puo' girare piu' volte:
# un "-dpi" gia' presente viene sostituito, non duplicato.
# Non si usa gtk-xft-dpi in gtkrc: GTK 2 lo ignora quando gira su X.
#
# Con il parametro di avvio ruscalinux.dpi=N (72-384) si sceglie il valore
# a mano; ruscalinux.dpi=96 torna all'aspetto di Debian.

rl_s62=/usr/lib/debian-installer.d/S62Xorg
[ -f "$rl_s62" ] || rl_s62=/lib/debian-installer.d/S62Xorg
rl_altezza=""
rl_dpi=""

# Valore scelto all'avvio
for rl_p in $(cat /proc/cmdline 2>/dev/null); do
	case "$rl_p" in
	ruscalinux.dpi=*) rl_dpi="${rl_p#ruscalinux.dpi=}" ;;
	esac
done
case "$rl_dpi" in
	''|*[!0-9]*) rl_dpi="" ;;
	*) [ "$rl_dpi" -lt 72 ] && rl_dpi=72
	   [ "$rl_dpi" -gt 384 ] && rl_dpi=384 ;;
esac

# Altezza dello schermo: prima il framebuffer (EFI, simpledrm, vesa), poi la
# modalita' preferita di un'uscita DRM collegata.
if [ -z "$rl_dpi" ]; then
	if [ -r /sys/class/graphics/fb0/virtual_size ]; then
		rl_altezza=$(cut -d, -f2 /sys/class/graphics/fb0/virtual_size 2>/dev/null)
	fi
	case "$rl_altezza" in ''|*[!0-9]*) rl_altezza="" ;; esac
	if [ -z "$rl_altezza" ]; then
		for rl_c in /sys/class/drm/card*-*; do
			[ -r "$rl_c/status" ] && [ "$(cat "$rl_c/status")" = connected ] || continue
			rl_altezza=$(head -n 1 "$rl_c/modes" 2>/dev/null | sed -n 's/^[0-9]*x\([0-9]*\).*/\1/p')
			[ -n "$rl_altezza" ] && break
		done
	fi
	if [ -n "$rl_altezza" ]; then
		rl_dpi=$((rl_altezza * 3 / 20))
		[ "$rl_dpi" -lt 96 ] && rl_dpi=96
		[ "$rl_dpi" -gt 384 ] && rl_dpi=384
	fi
fi

# Senza informazioni non si cambia nulla: resta l'aspetto di Debian.
if [ -n "$rl_dpi" ] && [ -f "$rl_s62" ]; then
	if grep -q 'Xorg \(-dpi [0-9]* \)\{0,1\}\$DPMS' "$rl_s62"; then
		sed -i "s/Xorg \(-dpi [0-9]* \)\{0,1\}\\\$DPMS/Xorg -dpi $rl_dpi \\\$DPMS/" "$rl_s62"
		chmod 755 "$rl_s62"
		logger -t ruscalinux "installer: Xorg a ${rl_dpi} DPI (schermo alto ${rl_altezza:-?} px)" 2>/dev/null || true
	else
		logger -t ruscalinux "installer: riga di Xorg non trovata in $rl_s62, testo invariato" 2>/dev/null || true
	fi
fi

unset rl_s62 rl_altezza rl_dpi rl_p rl_c
